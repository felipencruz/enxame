      "id": "07ff8814-0edc-438d-8550-694c09859c15",
      "name": "Conferir ml",
      "parameters": {
        "jsCode": "const origem = $('ml').all();\nconst enviado = $input.first().json;\nconst linhas = origem.length;\nif (linhas === 0) { throw new Error('tcc_bronze_ml: leitura vazia - nada exportado, nada a apagar'); }\nif (!enviado || !enviado.id) { throw new Error('tcc_bronze_ml: o upload nao devolveu id de arquivo'); }\nconst bytes = Number(enviado.size || 0);\nif (bytes < linhas * 40) { throw new Error('tcc_bronze_ml: CSV pequeno demais para ' + linhas + ' linhas (' + bytes + ' bytes) - possivel truncamento'); }\nconst ids = origem.map(i => Number(i.json.id)).filter(n => !isNaN(n));\nif (ids.length !== linhas) { throw new Error('tcc_bronze_ml: ha linha sem id numerico - corte inseguro'); }\nconst ultimo = origem.map(i => String(i.json.coletado_em || '')).reduce((a, b) => (b > a ? b : a), '');\nif (!ultimo) { throw new Error('tcc_bronze_ml: sem coletado_em - corte inseguro'); }\nconst antigos = origem.filter(i => String(i.json.coletado_em || '') < ultimo).map(i => Number(i.json.id));\nconst idCorte = antigos.reduce((a, b) => (b > a ? b : a), 0);\nreturn [{ json: { tabela: 'tcc_bronze_ml', linhas: linhas, id_corte: idCorte, a_purgar: antigos.length, preservadas: linhas - antigos.length, ultimo_snapshot: ultimo, arquivo: enviado.name, arquivo_id: enviado.id, bytes: bytes, sha256: enviado.sha256Checksum || null, exportado_em: new Date().toISOString() } }];"
      },
